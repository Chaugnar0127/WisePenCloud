{
  "version": 1,
  "service": "wisepen-system-service",
  "dataId": "wisepen-system-service-{profile}.yaml",
  "group": "DEFAULT_GROUP",
  "configs": {
    "batch-task-execution": {
      "name": "批量任务执行配置",
      "description": "单批执行数量和执行中任务超时认定参数。",
      "path": [
        "wisepen",
        "batch-task",
        "execution"
      ],
      "restartRequired": false,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "batch-size": {
            "type": "integer",
            "title": "单批执行任务项数量",
            "default": 20,
            "minimum": 1
          },
          "stale-minutes": {
            "type": "integer",
            "title": "执行中任务项超时分钟数",
            "default": 30,
            "minimum": 1
          }
        }
      }
    },
    "batch-task-schedule": {
      "name": "批量任务轮询调度",
      "description": "批量任务轮询间隔，发布后需要重启系统服务。",
      "path": [
        "wisepen",
        "batch-task",
        "schedule"
      ],
      "restartRequired": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "poll-delay-ms": {
            "type": "integer",
            "title": "任务轮询间隔（毫秒）",
            "default": 10000,
            "minimum": 1
          }
        }
      }
    }
  }
}
